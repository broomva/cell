{
	"hooks": {
		"PreToolUse": [
			{
				"matcher": "Bash",
				"hooks": [
					{ "type": "command", "command": "bun \"$CLAUDE_PROJECT_DIR\"/scripts/agent-pretool-gate.ts", "timeout": 10 }
				]
			}
		],
		"Stop": [
			{
				"hooks": [
					{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/agent-stop-gate.sh", "timeout": 180 }
				]
			}
		]
	}
}
